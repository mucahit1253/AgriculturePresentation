@model ServiceAddViewModel




<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Yeni Hizmet Kaydı</h4>
       
            <form asp-area="Admin" asp-controller="Service" asp-action="AddService" class="forms-sample">
                <div class="form-group">
                    <label asp-for="Title" >Başlık</label>
                    <input asp-for="Title" type="text" class="form-control"  placeholder="Başlık">
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Image">Görsel</label>
                    <input asp-for="Image" type="text" class="form-control"  placeholder="Göresel Url">
                    <span asp-validation-for="Image" class="text-danger"></span>

                </div>
              
                <div class="form-group">
                    <label asp-for="Description">Açıklama</label>
                    <textarea asp-for="Description" class="form-control"  rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>
                <button type="submit" class="btn btn-outline-info">Kaydet</button>
                <button asp-controller="Service" asp-action="Index" class="btn btn-outline-secondary">İptal</button>
            </form>
        </div>
    </div>
</div>