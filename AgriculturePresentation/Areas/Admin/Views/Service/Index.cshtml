@model List<Service>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Hizmet Listesi</h4>
            
            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        
                            @foreach (var item in Model)
                            {
                              <tr>
                                <td>@item.ServiceId</td>
                                <td>@item.Title</td>
                                <td><a asp-area="Admin" asp-controller="Service" asp-action="DeleteService" asp-route-id="@item.ServiceId" class="btn btn-outline-danger">Sil</a></td>
                                <td><a asp-area="Admin" asp-controller="Service" asp-action="UpdateService" asp-route-id="@item.ServiceId" class="btn btn-outline-warning">Güncelle</a></td>
                            </tr>

                            }

                           
                       
                    </tbody>
                </table>
                <br />
                <a asp-area="Admin" asp-controller="Service" asp-action="AddService" class="btn btn-outline-info">Yeni Hizmet</a>
            </div>
        </div>
    </div>
</div>