@model List<Admin>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Admin Listesi</h4>

            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Kullanıcı Adı</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AdminId</td>
                                <td>@item.UserName</td>
                                <td><a asp-area="Admin" asp-controller="Admin" asp-action="DeleteAdmin" asp-route-id="@item.AdminId" class="btn btn-outline-danger">Sil</a></td>
                                <td><a asp-area="Admin" asp-controller="Admin" asp-action="UpdateAdmin" asp-route-id="@item.AdminId" class="btn btn-outline-warning">Güncelle</a></td>
                            </tr>

                        }

                           
                       
                    </tbody>
                </table>
                <br />
                <a asp-area="Admin" asp-controller="Admin" asp-action="AddAdmin" class="btn btn-outline-info">Yeni Admin</a>
            </div>
        </div>
    </div>
</div>