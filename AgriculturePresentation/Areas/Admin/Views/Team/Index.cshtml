@model List<Team>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Takım Arkadaşlarımızın Listesi</h4>
            
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                             <th>#</th>
                             <th>ID</th>
                             <th>Ad</th>
                             <th>Görev</th>
                             <th>Sil</th>
                             <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                               <td class="py-1"><img src="~/MajesticAdmin-Free-Bootstrap-Admin-Template-master/template/images/faces/face1.jpg" alt="image" /> </td>
                               <td>@item.TeamId</td>
                               <td>@item.PersonName</td>
                               <td>@item.Title</td>
                               <td><a asp-area="Admin" asp-controller="Team" asp-action="DeleteTeam" asp-route-id="@item.TeamId" class="btn btn-outline-danger">Sil</a></td>
                               <td><a asp-area="Admin" asp-controller="Team" asp-action="UpdateTeam" asp-route-id="@item.TeamId" class="btn btn-outline-warning">Güncelle</a></td>
                            </tr>
                        }
                        
                    </tbody>
                </table>
                <br />
                <a asp-area="Admin" asp-controller="Team" asp-action="AddTeam" class="btn btn-outline-info">Yeni Personel</a>
            </div>
        </div>
    </div>
</div>