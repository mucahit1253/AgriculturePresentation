@model Announcement
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Güncelleme Sayfası</h4>

            <form asp-area="Admin" asp-controller="Announcement" asp-action="UpdateAnnouncement" class="forms-sample">
                <input asp-for="AnnouncementId" type="hidden" />
                <div class="form-group">
                    <label asp-for="Title">Başlık</label>
                    <input asp-for="Title" type="text" class="form-control" placeholder="Başlık Giriniz">
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Description">Açıklama</label>
                    <textarea asp-for="Description" rows="5" class="form-control" placeholder="Açıklama Giriniz"> </textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label asp-for="Date">Tarih</label>
                    <input asp-for="Date" type="date" class="form-control">
                    <span asp-validation-for="Date" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label asp-for="Status">Durum</label>
                    <select asp-for="Status" class="form-select">
                        <option value="">Durum seçiniz</option>
                        <option value="True">Aktif</option>
                        <option value="False">Pasif</option>

                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>

                </div>



                <button type="submit" class="btn btn-outline-info">Kaydet</button>
                <button asp-controller="Announcement" asp-action="Index" class="btn btn-outline-secondary">İptal</button>
            </form>
        </div>
    </div>
</div>