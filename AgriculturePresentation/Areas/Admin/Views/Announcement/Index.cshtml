@model List<Announcement>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Duyuru Listesi</h4>

            <div class="table-responsive pt-3">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Tarih</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                            <th>Aktif Yap</th>
                            <th>Pasif Yap</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AnnouncementId</td>
                                <td>@item.Title</td>
                                <td>@item.Date</td>
                                <td><a asp-area="Admin" asp-controller="Announcement" asp-action="DeleteAnnouncement" asp-route-id="@item.AnnouncementId" class="btn btn-outline-danger">Sil</a></td>
                                <td><a asp-area="Admin" asp-controller="Announcement" asp-action="UpdateAnnouncement" asp-route-id="@item.AnnouncementId" class="btn btn-outline-warning">Güncelle</a></td>
                                <td><a asp-area="Admin" asp-controller="Announcement" asp-action="ChangeStatusToTrue" asp-route-id="@item.AnnouncementId" class="btn @(item.Status ? "btn-success" : "btn-outline-success")">Aktif Yap</a></td>
                                <td><a asp-area="Admin" asp-controller="Announcement" asp-action="ChangeStatusToFalse" asp-route-id="@item.AnnouncementId" class="btn @(!item.Status ? "btn-dark" : "btn-outline-dark")">Pasif Yap</a></td>
                            </tr>

                        }

                           
                       
                    </tbody>
                </table>
                <br />
                <a asp-area="Admin" asp-controller="Announcement" asp-action="AddAnnouncement" class="btn btn-outline-info">Yeni Duyuru</a>
                <br />
            </div>
        </div>
    </div>
</div>