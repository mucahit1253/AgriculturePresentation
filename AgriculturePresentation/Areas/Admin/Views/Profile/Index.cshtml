@model UserEditViewModel
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Profil Güncelleme Sayfası</h4>

            <form asp-area="Admin" asp-controller="Profile" asp-action="Index" method="post" class="forms-sample">
                
                <div class="form-group">
                    <label asp-for="Mail">Mail Adresi</label>
                    <input asp-for="Mail" type="text" class="form-control" placeholder="mucahit@gmail.com">
                    <span asp-validation-for="Mail" class="text-danger"></span>

                </div>
                <div class="form-group">
                    <label asp-for="Phone">Telefon No</label>
                    <input asp-for="Phone" type="text" class="form-control" placeholder="+(90) 555 555 55 55">
                    <span asp-validation-for="Phone" class="text-danger"></span>

                </div>

                 
                <div class="form-group">
                    <label asp-for="Password">Şifre</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Yeni Şifre">
                    <span asp-validation-for="Password" class="text-danger"></span>

                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">Tekrar Şifre</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Tekrar Şifre">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

                </div>

                <button type="submit" class="btn btn-outline-info">Kaydet</button>
                <button asp-controller="Image" asp-action="Index" class="btn btn-outline-secondary">İptal</button>
            </form>
        </div>
    </div>
</div>