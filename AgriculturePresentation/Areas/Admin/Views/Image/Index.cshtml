@model List<Image>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Göresel Listesi</h4>
            
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Sil</th>
                            <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-1"> <img src="@item.ImageUrl" alt="Image" /> </td>
                                <td>@item.Title</td>
                                <td><a asp-area="Admin" asp-controller="Image" asp-action="DeleteImage" asp-route-id="@item.ImageId" class="btn btn-outline-danger">Sil</a></td>
                                <td><a asp-area="Admin" asp-controller="Image" asp-action="UpdateImage" asp-route-id="@item.ImageId" class="btn btn-outline-warning">Güncelle</a></td>
                            </tr>
                        }

                       
                       
                    </tbody>
                </table>
                <br />
                <a asp-area="Admin" asp-controller="Image" asp-action="AddImage" class="btn btn-outline-info">Yeni Görsel</a>
            </div>
        </div>
    </div>
</div>