@model List<Contact>

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Mesaj Listesi</h4>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ad Soyad</th>
                            <th>Mail</th>
                            <th>Tarih</th>
                            <th>Mesajı Gör</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                
                                <td>@item.Name</td>
                                <td>@item.Mail</td>
                                <td>@item.Date</td>
                                <td><a asp-area="Admin" asp-controller="Contact" asp-action="MessageDetail" asp-route-id="@item.ContactId" class="btn btn-outline-warning">Mesaj Detay</a></td>
                                <td><a asp-area="Admin" asp-controller="Contact" asp-action="DeleteMessage" asp-route-id="@item.ContactId" class="btn btn-outline-danger">Sil</a></td>
                            </tr>
                        }

                       
                       
                    </tbody>
                </table>
                
            </div>
        </div>
    </div>
</div>