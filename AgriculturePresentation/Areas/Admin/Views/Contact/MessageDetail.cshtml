@model Contact
<div class="col-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Mesaj Detayları Sayfası</h4>

        
                <input asp-for="ContactId" type="hidden" />
                <div class="form-group">
                    <label asp-for="Name">Ad Soyad</label>
                    <input asp-for="Name" type="text" class="form-control" placeholder="Ad Soyad">
                   

                </div>
                <div class="form-group">
                    <label asp-for="Mail">Mail Adress</label>
                    <input asp-for="Mail" type="email" class="form-control" placeholder="Mail giriniz">
                   

                </div>
                <div class="form-group">
                    <label asp-for="Date">Tarih</label>
                    <input asp-for="Date" type="date" class="form-control" placeholder="Tarih giriniz">


                </div>

                <div class="form-group">
                    <label asp-for="Message">Mesaj Detayı</label>
                    <textarea asp-for="Message" rows="5" class="form-control" placeholder="Mesaj Giriniz"> </textarea>
                   

                </div>

                <a asp-controller="Contact" asp-action="Index" class="btn btn-outline-secondary">İptal</a>
           
        </div>
    </div>
</div>